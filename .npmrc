# marked-abc@0.1.x declares a peer range of `marked >=17 <18`, but this project
# pins `marked@18.1.0` (required by the AstrBot+ markdown pipeline together with
# marked-katex-extension / marked-highlight, which both accept marked 18).
# The conflict is a stale peer range in marked-abc only; the runtime is fine.
# Using legacy peer resolution keeps `npm ci` working in CI.
legacy-peer-deps=true
