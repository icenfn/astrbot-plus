{
  "name": "astrbot-plus",
  "private": true,
  "version": "0.4.22",
  "type": "module",
  "description": "AstrBot+ — a modern client for AstrBot (Tauri + Vue 3 + Vuetify 4)",
  "author": "astrbot-plus contributors",
  "license": "MIT",
  "browserslist": [
    "chrome >= 61",
    "safari >= 12",
    "firefox >= 60",
    "edge >= 79"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "tauri": "tauri",
    "icons": "tauri icon ./app-icon.json",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "android:build:apk": "tauri android build --apk",
    "android:build:aab": "tauri android build --aab"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-http": "^2.8.0",
    "@tauri-apps/plugin-notification": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-sql": "^2.3.2",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^15.0.0",
    "alova": "^3.5.5",
    "highlight.js": "^11.10.0",
    "katex": "^0.16.11",
    "marked": "18.1.0",
    "marked-abc": "^0.1.1",
    "marked-highlight": "^2.2.1",
    "marked-katex-extension": "^5.1.2",
    "pinia": "^4.0.3",
    "socket.io-client": "^4.8.1",
    "vue": "^3.5.43",
    "vue-router": "^4.5.0",
    "vuetify": "^4.2.3"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@tauri-apps/cli": "^2.12.1",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-legacy": "^6.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "core-js": "^3.39.0",
    "postcss": "^8.4.49",
    "postcss-preset-env": "^10.1.1",
    "sass-embedded": "^1.105.1",
    "terser": "^5.37.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^2.1.0"
  }
}
